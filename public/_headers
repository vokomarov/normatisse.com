# Cloudflare Pages reads this file from the deploy root. Nuxt copies `public/`
# into `.output/public/`, which is what wrangler uploads, so this lands there.
# It has no effect on `nuxt dev` or a plain local static server.

/*
  # Everything the site needs comes from this origin: fonts are self-hosted by
  # @nuxt/fonts, icons are bundled locally by @nuxt/icon (`provider: 'none'`),
  # images are served by IPX. No analytics, no CDN, no embeds.
  #
  # `'unsafe-inline'` is unavoidable on both scripts and styles: Nuxt inlines the
  # hydration payload and Nuxt UI injects its theme block, and a static host has
  # no request-time hook to mint a nonce. `data:` on img-src covers the SVG mask
  # URIs @nuxt/icon emits in CSS mode.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  # Redundant with frame-ancestors above, but the older header is what most
  # scanners and a few legacy browsers actually look at.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The site uses none of these; deny them rather than inherit browser defaults.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # Sticky for a year in every browser that sees it. Safe here — Cloudflare
  # serves this zone over HTTPS only — but do not add `preload` without
  # committing to HTTPS on the apex permanently.
  Strict-Transport-Security: max-age=31536000

# Content-hashed filenames: a new build produces a new URL, so the old one can
# never go stale. Cloudflare's default of max-age=14400 re-validates for nothing.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

/_fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_ipx/*
  Cache-Control: public, max-age=31536000, immutable
